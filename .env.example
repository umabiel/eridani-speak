# LLM provider (OpenAI-compatible chat completions)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Local endpoints: llama.cpp, LM Studio, Ollama /v1, vLLM
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=local
# LLM_MODEL=qwen2.5-coder:7b

# Token counting: approximate | tiktoken
#   approximate - offline heuristic (~1 token per 4 chars)
#   tiktoken    - o200k_base via gpt-tokenizer (closer to GPT-4o)
# When the provider reports usage, provider numbers win over local counting.
LLM_TOKENIZER=approximate
